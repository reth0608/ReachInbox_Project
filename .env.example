# Copy this file to `.env` in the repo root before running docker-compose.
# docker-compose.yml overrides DATABASE_URL / REDIS_URL / PORT / CORS_ORIGIN
# / NEXTAUTH_URL / NEXT_PUBLIC_API_BASE_URL itself (pointing services at each
# other's container hostnames), so you generally don't need to set those
# here - just the secrets and tuning knobs below.

# --- Database & queue (used only for standalone/local runs outside Docker;
#     docker-compose supplies its own values for these) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- NextAuth ---
# Generate a strong secret, e.g.: openssl rand -base64 32
# Must be identical here and wherever the backend reads NEXTAUTH_SECRET -
# it's how the Express API verifies tokens minted by the frontend.
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Ethereal (fake SMTP for dev) ---
# Leave blank to auto-provision a fresh Ethereal test account on first
# `npm run db:seed` (the generated credentials are logged to the console -
# copy them back into this file to reuse the same inbox next time).
# Get your own anytime at https://ethereal.email/create
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Scheduling / rate limiting tuning ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
PROCESSING_STALE_TIMEOUT_MS=120000
RECONCILIATION_ON_STARTUP=true

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
